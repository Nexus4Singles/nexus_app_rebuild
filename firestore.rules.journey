// Firestore Security Rules for Journey Content
// Add these rules to your firestore.rules file under the main rules section

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Journey collection - public read access for all authenticated users
    match /journeys/{category}/files/{journeyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                      request.auth.token.admin == true;
    }
    
    // Journey history - admin only
    match /journeys/{category}/history/{document=**} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true;
      allow write: if request.auth != null && 
                      request.auth.token.admin == true;
    }
    
    // Analytics - anyone can write, admins can read
    match /analytics/journeyAccess/logs/{document=**} {
      allow read: if request.auth != null && 
                     request.auth.token.admin == true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
