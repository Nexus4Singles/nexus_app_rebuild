rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // Helpers
    // ============================================================================
    function isSignedIn() {
      return request.auth != null;
    }


        function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function participantIdsOf(data) {
      // Accept both v2 field (participantIds) and legacy alias (participants).
      // Be null-safe: if data isn't a map (e.g., doc doesn't exist), return [].
      return (data is map) ? (
        (data.participantIds is list) ? data.participantIds :
        (data.participants is list) ? data.participants :
        []
      ) : [];
    }



    function hasTwoParticipants(data) {
      return participantIdsOf(data).size() == 2;
    }

    function isParticipant(data) {
      // For reads/updates, only require that the requester is listed as a participant.
      // Do NOT require size()==2 here, because legacy/corrupt docs would cause false denies.
      return isSignedIn()
        && participantIdsOf(data).hasAny([request.auth.uid]);
    }


    function mapOrEmpty(v) {
      return (v is map) ? v : {};
    }

    function adminUserUpdateAllowed() {
      // Only allow admins to modify specific safe subsets on users/{uid}
      let changedTop = request.resource.data.diff(resource.data).changedKeys();

      // Allowed top-level keys that admins can modify
      // (dating, account, and profile-related fields that need deletion on rejection)
      let topOk =
        changedTop.hasOnly(['dating', 'account', 'photos', 'audioPrompts', 'audioDurations', 'profileUrl']) ||
        changedTop.hasOnly(['dating', 'account', 'photos', 'audioPrompts', 'audioDurations']) ||
        changedTop.hasOnly(['dating', 'account', 'photos', 'audioPrompts']) ||
        changedTop.hasOnly(['dating', 'account', 'photos']) ||
        changedTop.hasOnly(['dating', 'account']) ||
        changedTop.hasOnly(['dating', 'photos', 'audioPrompts', 'audioDurations', 'profileUrl']) ||
        changedTop.hasOnly(['dating']) ||
        changedTop.hasOnly(['account']);

      // dating.* allowed keys (admin verification workflow)
      let beforeDating = mapOrEmpty(resource.data.dating);
      let afterDating = mapOrEmpty(request.resource.data.dating);
      let datingChanged = afterDating.diff(beforeDating).changedKeys();

      let datingOk =
        !changedTop.hasAny(['dating']) ||
        datingChanged.hasOnly([
          'verificationStatus',
          'verifiedBy',
          'verifiedAt',
          'reviewedBy',
          'reviewedAt',
          'rejectedAt',
          'rejectionReason',
          'profileCompleted',
          'profile',
          'audioPrompts',
          'reviewPack'
        ]);

      // account.* allowed keys (admin moderation disable/enable)
      let beforeAcc = mapOrEmpty(resource.data.account);
      let afterAcc = mapOrEmpty(request.resource.data.account);
      let accChanged = afterAcc.diff(beforeAcc).changedKeys();

      let accountOk =
        !changedTop.hasAny(['account']) ||
        accChanged.hasOnly([
          'disabled',
          'disabledBy',
          'disabledAt',
          'disabledReason',
          'isDisabled'
        ]);

      return topOk && datingOk && accountOk;
    }
    // ============================================================================
    // USERS (v1 + v2 share the same collection)
    // ============================================================================

    // ============================================================================
    // USERS (v1 + v2 share the same collection)
    // ============================================================================
    match /users/{uid} {
      // Read policy:
      // - Signed-in users can read their own doc.
      // - Signed-in users can read other users ONLY if genders are opposite (male<->female).
      // - Optional admin override via custom claim: isAdmin()
      allow get: if isSignedIn();
      
      // List policy: Allow username lookups for login (unauthenticated users need this)
      // Note: This is for login flow where users query by username to get email
      allow list: if true;

      allow create: if isSignedIn() && request.auth.uid == uid;

      allow update: if (
        // CASE 1: Cloud Functions (service account) can update ANY fields for webhook processing
        request.auth == null
      ) || (
        // CASE 2: Authenticated user can update, but NOT subscription/payment fields
        isSignedIn() && (
          request.auth.uid == uid && 
          // ⚠️ SECURITY: Block client writes to subscription fields
          // Only Cloud Functions (service account) can write these fields
          !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'subscription',
            'onPremium',
            'subExpDate',
            'purchasedJourneys',
            'lastPurchaseAt',
            'lastPurchaseJourney',
            'entitledUser',
            'prevSubscribed',
            'lastFlutterwaveTransactionId',
            'lastPaymentMethod',
            'lastPaymentDate',
            'hasExternalSubscriptionFlow'
          ])
          ||
          (isAdmin() && adminUserUpdateAllowed())
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == uid;

      match /notifications/{notificationId} {
        // Allow user to manage their own notifications, or admin to create notifications for users
        allow read, create, update, delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }

      match /assessments/{assessmentId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        match /history/{historyId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }

      match /dating/{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /dailyProfilesViewed/{viewId} {
        allow read, create, update, delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /journeys/{journeyId} {
        allow list: if isSignedIn() && request.auth.uid == uid;
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid;
        match /responses/{responseId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }

      // SECURE PURCHASES: Only Cloud Functions can write via backend validation
      // Users can only read their own purchase history
      match /purchases/{purchaseId} {
        // Users can list their own purchases
        allow list: if isSignedIn() && request.auth.uid == uid;
        
        // Users can read their own purchases
        allow read: if isSignedIn() && request.auth.uid == uid;
        
        // ⛔ BLOCKED: No direct client writes - only Cloud Functions can create via validatePurchase()
        allow create: if false;
        
        // ⛔ BLOCKED: No client updates allowed
        allow update: if false;
        
        // ⛔ BLOCKED: No deletion (audit trail must be preserved)
        allow delete: if false;
      }
    }

    // ============================================================================
    // Nexus v2 Chats (strict + opposite gender enforced)
    // ============================================================================
    match /nexus2_chats/{chatId} {
      // GET: allow signed-in users to read chat docs (including checking if doc exists during create)
      allow get: if isSignedIn();

      // LIST: allow signed-in users to list their chats
      allow list: if isSignedIn();

      // CREATE: Allow any signed-in user to create chats (v2024-01-22)
      allow create: if isSignedIn();

      // UPDATE: Only participants can update chat metadata
      allow update: if isSignedIn() && isParticipant(resource.data);

      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/nexus2_chats/$(chatId)).data;
        }

        // READ: Any signed-in user who knows the chatId can read messages.
        // ChatIds are deterministic (uid1_uid2) so they are not guessable without
        // knowing both participant UIDs. Cloud Functions (request.auth == null) also allowed.
        allow read: if isSignedIn() || request.auth == null;

        // CREATE: Strict validation - only sender can create, must be participant
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in participantIdsOf(parentChat())
          && isParticipant(parentChat());

        // UPDATE: Participants can update their own messages
        // - Receiver: mark as read (isRead, readAt) or decline (isDeclined, declineReason, declinedAt)
        // - Sender: replace local path with cloud URL after background media upload
        allow update: if isSignedIn()
          && isParticipant(parentChat())
          && (request.auth.uid == resource.data.receiverId
              || request.auth.uid == resource.data.senderId);

        allow delete: if false;
      }
    }

// ============================================================================
// DEPRECATED: v1 chats collection (read-only)
// v1 app (old codebase) used this collection. v2 uses nexus2_chats.
// Reads are still allowed so old messages are accessible during transition.
// All writes are DENIED to force v1 users to update to v2.
// ============================================================================
match /chats/{chatId} {
  allow read: if isSignedIn() && (!(resource.data is map) || isParticipant(resource.data));
  allow list: if isSignedIn();
  allow create, update, delete: if false; // LOCKED — v1 deprecated

  match /messages/{messageId} {
    function parentChat() {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // READ: Allow participants to read + allow Cloud Functions for any legacy triggers
    allow read, list: if (isSignedIn() && (
      !(parentChat() is map) || isParticipant(parentChat())
    )) || request.auth == null;
    allow create, update, delete: if false; // LOCKED — v1 deprecated
  }
}

// ============================================================================
// App configuration (force-update, feature flags, etc.)
// Readable by anyone (needed for force-update check before/after auth).
// Only admin/backend can write.
// ============================================================================
match /config/{configId} {
  allow read: if true;
  allow write: if false; // Only settable via Firebase console or admin SDK
}

    // ============================================================================
    // Assessments / Journeys / Stories / Polls / Support (as referenced in code)
    // ============================================================================
    match /assessmentResults/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /results/{resultId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        match /history/{historyId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }

      // Journeys - now stored under user
      match /journeys/{journeyId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        match /responses/{responseId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    match /storyProgress/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /stories/{storyId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /pollAggregates/{pollId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /pollVotes/{pollId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /supportRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Public content (read-only)
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    match /journeys/{journeyId} {
      allow read: if true;
      allow write: if false;
    }

    // Story engagement/comments/likes
    match /storyEngagement/{storyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    match /storyComments/{storyId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount', 'updatedAt'])
          && request.resource.data.likeCount >= 0
          && request.resource.data.replyCount >= 0)
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /storyLikes/{storyId}/likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Comment likes for threaded comment system
    match /storyCommentLikes/{storyId}/likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && likeId.matches('^[^:]+:' + request.auth.uid + '$');
      allow delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid 
        && likeId.matches('^[^:]+:' + request.auth.uid + '$');
      allow update: if false;
    }

    // datingProfiles referenced by dating_profile_status_provider.dart
    match /datingProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ============================================================================
    // Unique Nationalities and Countries of Residence (For Analytics/Tracking)
    // ============================================================================
    match /nationalities/{document=**} {
      // All signed-in users can read nationalities
      allow read: if isSignedIn();
      // Signed-in users can increment count (for tracking onboarding)
      // Admins can full write (for data cleanup)
      allow write: if isSignedIn();
    }

    match /countriesOfResidence/{document=**} {
      // All signed-in users can read countries of residence
      allow read: if isSignedIn();
      // Signed-in users can increment count (for tracking onboarding)
      // Admins can full write (for data cleanup)
      allow write: if isSignedIn();
    }

    // ============================================================================
    // Content Management System (CMS) - Remote stories & polls (PUBLIC READ)
    // ============================================================================
    match /cms/{document=**} {
      // All users can read stories, polls, versions
      allow read: if true;
      // Only admins can write (for update script)
      allow write: if isAdmin();
    }

    // ============================================================================
    // User Reports & Moderation
    // ============================================================================
    match /reports/{reportId} {
      // Admins can read all reports
      allow read: if isAdmin();
      
      // Signed-in users can submit reports
      allow create: if isSignedIn();
      
      // Only admins can update/delete (for status changes and cleanup)
      allow update, delete: if isAdmin();
    }

    // ============================================================================
    // COACH APPLICATIONS
    // ============================================================================
    match /coachApplications/{applicationId} {
      // Any signed-in user can create (submit) an application
      allow create: if isSignedIn();

      // Applicant can read their own application
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;

      // Admins can read and update any application for review
      allow get, list, update: if isAdmin();

      // Admins can delete applications (if needed for cleanup)
      allow delete: if isAdmin();

      // No direct write access for non-admins except create
      allow list: if false;  // Prevent non-admins from listing all applications
    }

    // ============================================================================
    // AUDIT LOGS (Cloud Functions only)
    // ============================================================================
    // Users can read their own audit logs to verify payment history
    // Cloud Functions write via Admin SDK (bypasses Firestore rules entirely)
    match /users/{uid}/auditLog/{entryId} {
      // Users can read their own audit logs
      allow read: if isSignedIn() && request.auth.uid == uid;
      
      // Cloud Functions use Admin SDK to write (bypasses these rules)
      // These rules are here for documentation; writes use privileged access
      allow create, update, delete: if false;
    }

    // ============================================================================
    // JOURNEY PURCHASES (Cloud Functions writes, Users read)
    // ============================================================================
    // Users can read their own journey purchases
    // Cloud Functions create entries when payment is successful via Admin SDK
    match /users/{uid}/journeyPurchases/{purchaseId} {
      // Users can read their own purchases
      allow read: if isSignedIn() && request.auth.uid == uid;
      
      // Cloud Functions use Admin SDK to write (bypasses these rules)
      // These rules are here for documentation; writes use privileged access
      allow create, update, delete: if false;
    }

    // ============================================================================
    // SUBSCRIPTION PAYMENT FIELDS (Cloud Functions only, protected from direct user writes)
    // ============================================================================
    // These sensitive fields should ONLY be written by Cloud Functions (Flutterwave webhook)
    // Users can read their own subscription status
    match /users/{uid} {
      // Existing rules above...
      
      // Additional rule: Users can see their own subscription status
      // This is a read-only view of subscription fields
      function getSubscriptionFields() {
        return {
          'onPremium': resource.data.get('onPremium', false),
          'subExpDate': resource.data.get('subExpDate', ''),
          'entitledUser': resource.data.get('entitledUser', false),
          'prevSubscribed': resource.data.get('prevSubscribed', false),
          'lastFlutterwaveTransactionId': resource.data.get('lastFlutterwaveTransactionId', ''),
          'lastPaymentMethod': resource.data.get('lastPaymentMethod', ''),
          'lastPaymentDate': resource.data.get('lastPaymentDate', null),
          'hasExternalSubscriptionFlow': resource.data.get('hasExternalSubscriptionFlow', false),
        };
      }
    }

    // ============================================================================
    // COACHES
    // ============================================================================
    match /coaches/{coachId} {
      // Any signed-in user can browse coaches
      allow read, list: if isSignedIn();

      // Coach can update their own profile (userId field must match)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Only admins can create/delete coach profiles (approved via application flow)
      allow create, delete: if isAdmin();

      // ── Availability slots ────────────────────────────────────────────────
      match /slots/{slotId} {
        // Any signed-in user can read slots (needed for calendar + booking)
        allow read, list: if isSignedIn();

        // Coach can add/remove their own slots
        allow create: if isSignedIn()
          && request.resource.data.coachId == request.auth.uid;

        allow delete: if isSignedIn()
          && resource.data.coachId == request.auth.uid;

        // Slots can be updated by:
        //  - The coach themselves (e.g. removing a slot)
        //  - Any signed-in user booking the slot (isBooked, bookingId fields only)
        allow update: if isSignedIn() && (
          resource.data.coachId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isBooked', 'bookingId'])
        );
      }
    }

    // ============================================================================
    // BOOKINGS
    // ============================================================================
    match /bookings/{bookingId} {
      // User or coach can read their own bookings
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.coachId == request.auth.uid
      );

      // Users can list/stream their own bookings; coaches can stream theirs
      allow list: if isSignedIn();

      // Any signed-in user can create a booking for themselves
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Updates allowed by:
      //  - The user who made the booking (cancel, add notes)
      //  - The coach (mark complete)
      //  - Cloud Functions (service account, auth == null) for payment confirmation
      allow update: if (request.auth == null) || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.coachId == request.auth.uid
        )
      );

      // No deletes — bookings are permanent for audit trail
      allow delete: if false;
    }

    // ============================================================================
    // BOOKING RATINGS
    // ============================================================================
    match /bookingRatings/{ratingId} {
      // User or coach can read ratings relevant to them
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.coachId == request.auth.uid
      );

      // Coaches can list their own ratings (for display on profile)
      allow list: if isSignedIn();

      // User can create/update a rating for their own booking
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    // ============================================================================
    // MARKETS (UK Launch)
    // ============================================================================
    match /markets/{market} {
      // All signed-in users can read market phase/status
      allow read: if isSignedIn();
      
      // Only admin/backend can write
      allow write: if isAdmin();
    }

    // ============================================================================
    // DAILY PROFILES (Carousel for UK/other markets)
    // ============================================================================
    match /dailyProfiles/{date} {
      // Allow signed-in users to read daily profiles for any date
      allow read: if isSignedIn();
      
      // Only admin/backend can write (populated by Cloud Functions)
      allow write: if isAdmin();
      
      match /users/{uid} {
        // Users can read their own daily profiles
        allow read: if isSignedIn() && request.auth.uid == uid;
        
        // Cloud Functions can write
        allow write: if isAdmin();
      }
    }

    // ============================================================================
    // WAITING LIST STATS (UK Launch - Gender Distribution)
    // ============================================================================
    // Note: This is accessed via config/waitingListStats/countries/{country}
    // The config rule allows read: if true, but we need explicit subcollection rules
    match /config/waitingListStats/countries/{country} {
      // All signed-in users can read waiting list stats
      allow read: if isSignedIn();
      
      // Only admin/backend can write
      allow write: if isAdmin();
    }

    // ============================================================================
    // Default deny
    // ============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
